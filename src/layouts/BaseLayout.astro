---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import { SITE } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image = SITE.ogImage,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.shortName}` : `${SITE.name} — ${SITE.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(image, Astro.site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: SITE.url,
  jobTitle: SITE.title,
  worksFor: SITE.currentRoles.map((role) => ({ '@type': 'Organization', name: role.company })),
  knowsAbout: [...SITE.knowsAbout],
  sameAs: [SITE.social.linkedin, SITE.social.github],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Málaga',
    addressCountry: 'Spain',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {/* Apply saved theme before paint to avoid a flash */}
    <script is:inline>
      if (localStorage.getItem("theme") === "light") {
        document.documentElement.dataset.theme = "light";
      }
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1a1614" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.shortName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Self-hosted fonts (Fontsource) — @font-face + preload, no third-party origin */}
    <Font cssVariable="--font-fraunces" preload />
    <Font cssVariable="--font-hanken" preload />
    <Font cssVariable="--font-jetbrains-mono" />

    <ClientRouter />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only rounded-lg focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-bg"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
