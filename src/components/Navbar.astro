---
import { NAV_LINKS, SITE } from '../consts';
---

<header
  class="sticky top-0 z-40 border-b border-hairline bg-bg/75 backdrop-blur-md backdrop-saturate-150"
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5" aria-label="Primary">
    <a href="#main-content" class="font-mono text-base font-medium tracking-tight text-ink">
      <span class="text-accent">&lt;</span>{SITE.shortName.split(' ')[0]}<span class="text-accent"
        >/&gt;</span
      >
    </a>

    <div class="flex items-center gap-3">
      {/* Desktop links */}
      <ul class="hidden items-center gap-8 md:flex">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-ink-soft transition-colors duration-200 hover:text-ink"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="#contact"
            class="rounded-sm border border-hairline-strong px-4 py-2 text-sm font-medium text-ink transition-colors duration-200 hover:border-accent hover:text-accent"
          >
            Let's talk
          </a>
        </li>
      </ul>

      {/* Theme toggle — always visible */}
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle color theme"
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-sm border border-hairline-strong text-ink transition-colors duration-200 hover:border-accent hover:text-accent"
      >
        <svg class="theme-icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" /></svg>
        <svg class="theme-icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg>
      </button>

      {/* Mobile disclosure — zero-JS via <details> */}
      <details class="group relative md:hidden">
        <summary
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-sm border border-hairline-strong text-ink [&::-webkit-details-marker]:hidden"
          aria-label="Toggle menu"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 6h18M3 12h18M3 18h18" class="group-open:hidden" />
            <path d="M6 6l12 12M6 18L18 6" class="hidden group-open:block" />
          </svg>
        </summary>
        <ul
          class="absolute right-0 mt-3 w-48 rounded-lg border border-hairline bg-bg-elevated p-2 shadow-[var(--shadow-lift)]"
        >
          {
            NAV_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="block rounded-sm px-3 py-2 text-sm text-ink-soft transition-colors hover:bg-surface hover:text-ink"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const isLight = document.documentElement.dataset.theme === 'light';
    if (isLight) {
      document.documentElement.removeAttribute('data-theme');
      localStorage.setItem('theme', 'dark');
    } else {
      document.documentElement.dataset.theme = 'light';
      localStorage.setItem('theme', 'light');
    }
  });
</script>
