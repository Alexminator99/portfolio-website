---
import Section from './Section.astro';
import { SITE } from '../consts';

const stats = [
  { value: '9+', label: 'Years on Android' },
  { value: '5+', label: 'Years on iOS' },
  { value: '10+', label: 'Companies shipped for' },
];

const facts = [
  { label: 'Based in', value: SITE.location },
  { label: 'Now', value: `${SITE.currentRole.title} @ ${SITE.currentRole.company}` },
  { label: 'Education', value: 'B.S. Computer Science' },
  { label: 'Languages', value: 'Spanish & English' },
  { label: 'Also into', value: 'IoT with Arduino · Football' },
  { label: 'Cloud', value: 'AWS & GCP' },
];

const exploring = [
  'Advanced Jetpack Compose',
  'Kotlin Multiplatform',
  'SwiftUI Animations',
  'iOS Performance',
];
---

<Section id="about" index="01" eyebrow="About" title="Nine years of shipping native mobile.">
  <div class="grid gap-12 lg:grid-cols-[1.3fr_0.7fr]">
    <div class="reveal space-y-5 text-ink-soft">
      <p>
        I'm a Lead Mobile Engineer with <span class="text-ink">9+ years</span> building native Android
        and iOS apps that people actually use. My foundation is Kotlin, Swift and Java, applying SOLID
        principles and Clean Architecture to keep code maintainable and scalable.
      </p>
      <p>
        I work daily in modern UI frameworks — <span class="text-ink">Jetpack Compose</span> and
        <span class="text-ink">SwiftUI</span> — and ship cross-platform with Kotlin Multiplatform. Beyond
        product work, a background in mobile security and reverse engineering means the apps I build are
        resilient, not just functional.
      </p>

      <dl class="grid grid-cols-3 gap-6 border-t border-hairline pt-8">
        {
          stats.map((s) => (
            <div>
              <dt class="font-display text-4xl font-semibold text-accent">{s.value}</dt>
              <dd class="mt-1 text-sm text-ink-muted">{s.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="reveal">
      <dl class="space-y-4">
        {
          facts.map((f) => (
            <div class="flex flex-col gap-1 border-b border-hairline pb-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
              <dt class="eyebrow shrink-0">{f.label}</dt>
              <dd class="text-sm text-ink sm:text-right">{f.value}</dd>
            </div>
          ))
        }
      </dl>

      <p class="eyebrow mt-8">Currently exploring</p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {
          exploring.map((e) => (
            <li class="rounded-sm border border-hairline px-3 py-1.5 font-mono text-xs text-ink-soft">
              {e}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>
