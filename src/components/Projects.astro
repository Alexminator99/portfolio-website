---
import { getCollection } from 'astro:content';
import Section from './Section.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const ICONS: Record<string, string> = {
  appStore:
    'M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z',
  playStore:
    'M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z',
  web: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm6.93 6h-2.95a15.65 15.65 0 00-1.38-3.56A8.03 8.03 0 0118.92 8zM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96zM4.26 14C4.1 13.36 4 12.69 4 12s.1-1.36.26-2h3.38c-.08.66-.14 1.32-.14 2 0 .68.06 1.34.14 2H4.26zm.82 2h2.95c.32 1.25.78 2.45 1.38 3.56A7.987 7.987 0 015.08 16zm2.95-8H5.08a7.987 7.987 0 014.33-3.56A15.65 15.65 0 008.03 8zM12 19.96c-.83-1.2-1.48-2.53-1.91-3.96h3.82c-.43 1.43-1.08 2.76-1.91 3.96zM14.34 14H9.66c-.09-.66-.16-1.32-.16-2 0-.68.07-1.35.16-2h4.68c.09.65.16 1.32.16 2 0 .68-.07 1.34-.16 2zm.25 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95a8.03 8.03 0 01-4.33 3.56zM16.36 14c.08-.66.14-1.32.14-2 0-.68-.06-1.34-.14-2h3.38c.16.64.26 1.31.26 2s-.1 1.36-.26 2h-3.38z',
};
const LABELS: Record<string, string> = {
  appStore: 'App Store',
  playStore: 'Play Store',
  web: 'Website',
};
const ORDER = ['appStore', 'playStore', 'web'] as const;
---

<Section id="work" index="03" eyebrow="Selected Work" title="Apps I've built & shipped">
  <div class="grid gap-5 sm:grid-cols-2">
    {
      projects.map((p) => {
        const links = ORDER.filter((k) => p.data.links[k]);
        return (
          <article class="reveal surface flex flex-col p-6 sm:p-7">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="font-display text-2xl font-semibold text-ink">{p.data.name}</h3>
              <span class="eyebrow shrink-0 pt-1">{p.data.company}</span>
            </div>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-soft">{p.data.description}</p>
            {links.length > 0 && (
              <div class="mt-6 flex flex-wrap gap-2">
                {links.map((k) => (
                  <a
                    href={p.data.links[k]}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-2 rounded-sm border border-hairline px-3 py-1.5 font-mono text-xs text-ink-soft transition-colors duration-200 hover:border-accent hover:text-accent"
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d={ICONS[k]} />
                    </svg>
                    {LABELS[k]}
                  </a>
                ))}
              </div>
            )}
          </article>
        );
      })
    }
  </div>
</Section>
