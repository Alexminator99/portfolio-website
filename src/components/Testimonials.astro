---
import Section from './Section.astro';

const testimonials = [
  {
    quote:
      'Alex took ownership of our mobile platform while we were bridging Web2 and Web3 email. He led both the Android and iOS apps, shipped wallet-to-wallet flows most teams would shy away from, and kept quality high while we moved fast.',
    name: 'Shant Kevonian',
    initials: 'SK',
    role: 'CEO',
    company: 'EtherMail',
  },
  {
    quote:
      'Alex leads our mobile engineering end to end — a Kotlin Multiplatform app with native Compose and SwiftUI UIs, payments, real-time chat, and AI features. He turned an ambitious product vision into stable apps on both stores.',
    name: 'Denis',
    initials: 'D',
    role: 'CTO',
    company: 'MindGuard Group',
  },
  {
    quote:
      'As our Android Tech Lead, Alex owns the full lifecycle — releases, feature delivery, and the technical standards the rest of the team follows. He brought order and confidence to our Android practice.',
    name: 'Aitor',
    initials: 'A',
    role: 'CTO',
    company: 'Atos',
  },
  {
    quote:
      'Alex joined us as a Senior Mobile Engineer and ramped up in no time. Strong across the whole mobile stack, easy to work with, and someone you can hand a complex problem to and trust the outcome.',
    name: 'Javier',
    initials: 'J',
    role: 'Tech Lead',
    company: 'SIROC',
  },
  {
    quote:
      'Alex led development of our retail EPOS Android app — offline mode, receipt printing, Clover integration, and device-to-device sync. He delivered a field-ready product our customers rely on every day.',
    name: 'Dave',
    initials: 'D',
    role: 'CEO',
    company: 'Aptimyz',
  },
  {
    quote:
      'Alex worked with us for over three years across Android and iOS, and he was the engineer we trusted with the hardest client projects. Reliable, autonomous, and always delivering production-ready work.',
    name: 'Adrian',
    initials: 'A',
    role: 'CTO',
    company: 'DSpot Team',
  },
];
---

<Section id="testimonials" index="06" eyebrow="Testimonials" title="What people I've worked with say.">
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      testimonials.map((t) => (
        <figure class="reveal surface flex flex-col p-7">
          <blockquote class="flex-1 font-display text-lg leading-relaxed text-ink">
            <span class="text-accent">&ldquo;</span>
            {t.quote}
            <span class="text-accent">&rdquo;</span>
          </blockquote>
          <figcaption class="mt-6 flex items-center gap-3 border-t border-hairline pt-5">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-hairline-strong font-mono text-xs text-accent">
              {t.initials}
            </span>
            <span class="text-sm">
              <span class="block text-ink">{t.name}</span>
              <span class="block text-ink-muted">{t.role}, {t.company}</span>
            </span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</Section>
