---
import Section from './Section.astro';
import { SITE } from '../consts';

const recommendations = [
  {
    summary:
      'Credits Alex with architecting an offline-capable Android EPOS app on Clean Architecture, and highlights how he mentors junior developers, pushes for CI/CD, and works across product, design, and QA in English and Spanish.',
    name: 'Alejandro Milián Morón',
    initials: 'AM',
    title: 'Senior Software Engineer, LexisNexis',
    context: 'Studied together · Apr 2025',
  },
  {
    summary:
      'Saw Alex grow quickly over three years together: a fast learner and clear communicator who kept delivering while completing his degree.',
    name: 'Guelmis Martinez',
    initials: 'GM',
    title: 'Senior IT Project Manager',
    context: 'Managed Alex directly · Nov 2024',
  },
  {
    summary:
      "Worked with Alex for more than four years, including on Aptimyz's retail ePOS apps for Android and iOS, and singles out his Clover SDK integrations, his Bluetooth LE know-how, and how readily he mentors teammates.",
    name: 'Daniel Placencia Alvarez',
    initials: 'DP',
    title: 'DevOps/MLOps Engineer',
    context: 'Same team · Oct 2024',
  },
  {
    summary:
      'A teammate from mobile app development who calls Alex an exceptional professional: strong at solving complex problems, quick to share knowledge and support the team, and meticulous about quality.',
    name: 'Elieser Pérez Reyes',
    initials: 'EP',
    title: 'Computer Science graduate',
    context: 'Same team · Jan 2024 · Originally in Spanish',
  },
  {
    summary:
      'Worked with Alex at Aptimyz Retail and credits him with delivering its flagship mobile app and integrating new hardware with secure payment processing, both on time and on budget.',
    name: 'Charles Major',
    initials: 'CM',
    title: 'Product leader, payments & AI',
    context: 'Senior colleague at Aptimyz Retail · Nov 2023',
  },
];
---

<Section
  id="testimonials"
  index="06"
  eyebrow="Recommendations"
  title="What people I've worked with say."
  intro="Highlights from my LinkedIn recommendations, summarized."
>
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      recommendations.map((r) => (
        <figure class="reveal surface flex flex-col p-7">
          <p class="flex-1 font-display text-lg leading-relaxed text-ink">{r.summary}</p>
          <figcaption class="mt-6 flex items-center gap-3 border-t border-hairline pt-5">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-hairline-strong font-mono text-xs text-accent">
              {r.initials}
            </span>
            <span class="text-sm">
              <span class="block text-ink">{r.name}</span>
              <span class="block text-ink-muted">{r.title}</span>
              <span class="mt-1 block font-mono text-[0.7rem] text-ink-muted">{r.context}</span>
            </span>
          </figcaption>
        </figure>
      ))
    }
  </div>

  <div class="reveal mt-8">
    <a
      href={`${SITE.social.linkedin}/details/recommendations/`}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-2 rounded-sm border border-hairline px-3 py-1.5 font-mono text-xs text-ink-soft transition-colors duration-200 hover:border-accent hover:text-accent"
    >
      Read them in full on LinkedIn
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
    </a>
  </div>
</Section>
